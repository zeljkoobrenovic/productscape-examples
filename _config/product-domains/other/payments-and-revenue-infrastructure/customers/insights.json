    {
      "id": "pri-01",
      "title": "Financial infrastructure spans several customer buying decisions",
      "summary": "Stripe’s 2025 update reports payment scale alongside revenue and platform businesses. Adyen now describes an enterprise money-movement proposition.",
      "implication": "Modeling implication: Keep the merchant, recurring-revenue and platform loops, with treasury as a distinct buyer and responsibility boundary.",
      "priority": "high",
      "tags": [
        "scope",
        "business-model"
      ],
