    {
      "id": "pri-02",
      "title": "Payment performance must include conversion, loss and cost",
      "summary": "Adyen Uplift connects method presentation, tokenization, risk, authentication and optimization through five modules. Adyen announced Visa Payment Passkey through Authenticate on October 29, 2026, initially in the UK; wider expansion is planned for 2027.",
      "implication": "Modeling implication: Evaluate the full payment funnel on a fixed merchant cohort; authorization lift alone is not the customer outcome. Compare authentication options within eligible markets and cohorts; a future expansion date is not current availability.",
      "priority": "high",
      "tags": [
        "adyen",
        "conversion",
        "risk"
      ],
      "sourceIds": [
        "adyen-uplift",
        "adyen-passkey"
