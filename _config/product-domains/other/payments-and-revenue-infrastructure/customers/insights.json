    {
      "id": "pri-03",
      "title": "Usage monetization now includes acquired billing platforms",
      "summary": "Stripe completed Metronome in January 2026; Adyen completed Orb in July. Stripe documentation recommends Metronome for new usage integrations while preserving supported Meters paths.",
      "implication": "Modeling implication: Model contract versions, credits, metering corrections and invoice/collection handoffs, with compatibility and integration state visible.",
      "priority": "high",
      "tags": [
        "billing",
        "stripe",
        "adyen"
      ],
      "sourceIds": [
